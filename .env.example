# --- Site ---
PUBLIC_SITE_URL=https://protegeclub.com.br            # URL canônica, usada em OG tags/sitemap
PUBLIC_WHATSAPP_NUMBER=+556499998888                   # link wa.me de fallback (footer/header)

# --- Supabase (Postgres) ---
PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co          # URL do projeto, seguro expor
SUPABASE_SERVICE_ROLE_KEY=                             # SOMENTE SERVIDOR. Ignora RLS. Nunca expor ao navegador.

# --- Bitrix24 CRM ---
BITRIX24_WEBHOOK_URL=                                  # ex: https://seuportal.bitrix24.com.br/rest/1/xxxxxxxxxxxx/ — SOMENTE SERVIDOR (token vai na própria URL)

# --- Cloudflare Turnstile (anti-spam no formulário de lead) ---
PUBLIC_TURNSTILE_SITE_KEY=                             # público, renderizado no widget
TURNSTILE_SECRET_KEY=                                  # SOMENTE SERVIDOR, valida o token em /api/lead

# --- Analytics (opcional — deixe em branco para desativar) ---
PUBLIC_GA4_MEASUREMENT_ID=                             # ex: G-XXXXXXX
PUBLIC_META_PIXEL_ID=                                  # ID do Meta/Facebook Pixel

# --- Cloudflare (só necessário para deploy via CLI, não p/ deploy via Git nativo do Pages) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
