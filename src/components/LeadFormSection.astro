---
import LeadForm from "../islands/LeadForm/LeadForm";

interface Props {
  regionSlug: string;
  regionDisplayName: string;
  whatsappNumber: string;
}

const { regionSlug, regionDisplayName, whatsappNumber } = Astro.props;
---

<section id="quero-proteger" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
  <h2 class="reveal-up text-center text-3xl font-bold text-brand-navy sm:text-4xl">
    Fale com um consultor agora
  </h2>
  <p class="reveal-up mx-auto mt-3 max-w-xl text-center text-slate-600">
    Responda 5 perguntas rápidas e um consultor da Protege Club te chama no WhatsApp.
  </p>
  <div class="mt-10">
    <LeadForm
      client:visible
      regionSlug={regionSlug}
      regionDisplayName={regionDisplayName}
      whatsappNumber={whatsappNumber}
    />
  </div>
</section>
