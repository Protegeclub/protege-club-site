---
import { getEntry } from "astro:content";
import TestimonialCard from "./TestimonialCard.astro";

interface Props {
  testimonialIds: string[];
}

const { testimonialIds } = Astro.props;
const entries = (
  await Promise.all(testimonialIds.map((id) => getEntry("testimonials", id)))
).filter((entry) => entry !== undefined);
---

{
  entries.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <h2 class="text-center text-3xl font-bold text-brand-navy sm:text-4xl">Quem já é Protege Club</h2>
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => (
          <TestimonialCard
            name={entry.data.name}
            city={entry.data.city}
            quote={entry.data.quote}
            vehicle={entry.data.vehicle}
          />
        ))}
      </div>
    </section>
  )
}
