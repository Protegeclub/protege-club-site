---
interface Props {
  name: string;
  city: string;
  quote: string;
  vehicle?: string;
  rating?: number;
}

const { name, city, quote, vehicle, rating = 5 } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase() || "?";
---

<figure class="reveal-up flex h-full flex-col rounded-2xl bg-white p-6 shadow-md transition hover:-translate-y-1 hover:shadow-lg">
  <div class="flex gap-0.5 text-brand-orange" aria-label={`${rating} de 5 estrelas`}>
    {
      Array.from({ length: 5 }).map((_, i) => (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class={`h-4 w-4 ${i < rating ? "" : "opacity-20"}`}
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.447a1 1 0 00-.363 1.118l1.287 3.957c.3.922-.755 1.688-1.538 1.118l-3.367-2.447a1 1 0 00-1.176 0l-3.367 2.447c-.783.57-1.838-.196-1.538-1.118l1.287-3.957a1 1 0 00-.363-1.118L2.062 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.287-3.958z" />
        </svg>
      ))
    }
  </div>
  <blockquote class="mt-3 flex-1 text-slate-700">
    <p>&ldquo;{quote}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-white">
      {initial}
    </span>
    <div>
      <p class="font-semibold text-brand-navy">{name}</p>
      <p class="text-sm text-slate-500">{city}{vehicle ? ` · ${vehicle}` : ""}</p>
    </div>
  </figcaption>
</figure>
