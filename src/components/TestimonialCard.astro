---
interface Props {
  name: string;
  city: string;
  quote: string;
  vehicle?: string;
}

const { name, city, quote, vehicle } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase() || "?";
---

<figure class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <blockquote class="flex-1 text-slate-700">
    <p>&ldquo;{quote}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-white">
      {initial}
    </span>
    <div>
      <p class="font-semibold text-brand-navy">{name}</p>
      <p class="text-sm text-slate-500">{city}{vehicle ? ` · ${vehicle}` : ""}</p>
    </div>
  </figcaption>
</figure>
