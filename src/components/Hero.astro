---
import { Picture } from "astro:assets";
import ArrowButton from "./ArrowButton.astro";
import Logo from "./Logo.astro";
import consultorPhoto from "../assets/photos/consultor-hero.png";

interface Props {
  regionDisplayName: string;
  headline: string;
  subheadline: string;
  startingPriceLabel: string;
  supportHoursLabel: string;
  gracePeriodDays?: number;
  whatsappNumber: string;
}

const {
  regionDisplayName,
  headline,
  subheadline,
  startingPriceLabel,
  supportHoursLabel,
  gracePeriodDays,
  whatsappNumber,
} = Astro.props;

const waHref = `https://wa.me/${whatsappNumber.replace(/\D/g, "")}?text=${encodeURIComponent(
  "Olá! Quero saber mais sobre a proteção veicular da Protege Club."
)}`;
---

<section class="relative overflow-hidden bg-brand-blue px-4 pb-16 pt-6 sm:px-6 sm:pb-24 sm:pt-8">
  <div class="mx-auto max-w-7xl">
    <div class="flex items-center justify-between">
      <Logo />
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-brand-navy transition hover:brightness-95 sm:px-5 sm:text-base"
      >
        Falar no WhatsApp
      </a>
    </div>

    <div class="relative mt-10">
      <div class="relative overflow-hidden rounded-3xl bg-[#EFF8FD] p-6 sm:p-8">
        <svg
          class="pointer-events-none absolute right-[28%] top-1/2 hidden h-[90%] w-[38%] -translate-y-1/2 text-brand-navy/[0.07] md:block"
          viewBox="0 0 260 320"
          fill="none"
          aria-hidden="true"
        >
          <g stroke="currentColor" stroke-width="2">
            <path d="M0 40H260" /><path d="M0 110H260" /><path d="M0 175H260" />
            <path d="M0 245H260" /><path d="M0 300H260" />
            <path d="M30 0V320" /><path d="M110 0V320" /><path d="M190 0V320" />
          </g>
          <g transform="translate(110 175)">
            <circle r="36" fill="currentColor" opacity="0.5" />
            <g transform="translate(-16 -10)" fill="currentColor" opacity="0.95">
              <rect x="0" y="7" width="32" height="11" rx="3" />
              <rect x="6" y="0" width="20" height="9" rx="2" />
              <circle cx="7" cy="19" r="3.5" />
              <circle cx="25" cy="19" r="3.5" />
            </g>
          </g>
        </svg>

        <div class="relative flex max-w-lg flex-col items-start gap-4">
          <p class="inline-flex items-center gap-2 rounded-full bg-brand-navy/5 px-4 py-1.5 text-sm font-medium text-brand-navy">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
            </span>
            {supportHoursLabel}
          </p>
          <h1 class="text-4xl font-extrabold leading-tight text-brand-navy sm:text-5xl">
            {headline}
          </h1>
          <p class="max-w-md text-lg text-slate-600">
            {subheadline}
          </p>
          <p class="text-base text-slate-700">
            <span class="font-bold text-brand-orange">{startingPriceLabel}</span>
            {gracePeriodDays && ` · 1ª mensalidade em ${gracePeriodDays} dias`}
          </p>
          <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
            <ArrowButton href="#quero-proteger" label="Quero economizar agora" />
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="flex w-full items-center justify-center whitespace-nowrap rounded-full border border-brand-navy/15 px-6 py-3.5 text-base font-bold text-brand-navy transition hover:bg-brand-navy/5 sm:w-auto"
            >
              Falar no WhatsApp
            </a>
          </div>
        </div>
      </div>

      <div class="mt-4 flex justify-center lg:hidden">
        <Picture
          src={consultorPhoto}
          alt="Consultor da Protege Club"
          formats={["avif", "webp"]}
          fallbackFormat="png"
          widths={[280, 360]}
          sizes="280px"
          width={280}
          loading="eager"
          class="w-full max-w-[280px]"
        />
      </div>
    </div>

    <p class="mt-4 flex items-center gap-1.5 text-sm font-medium text-white/80">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
        <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
      </svg>
      {regionDisplayName}
    </p>
  </div>

  <div class="pointer-events-none absolute inset-0 hidden lg:flex">
    <div class="mx-auto flex h-full w-full max-w-7xl items-end justify-end px-4 sm:px-6">
      <Picture
        src={consultorPhoto}
        alt="Consultor da Protege Club"
        formats={["avif", "webp"]}
        fallbackFormat="png"
        widths={[610, 723]}
        sizes="723px"
        width={723}
        height={640}
        loading="eager"
        fetchpriority="high"
        class="h-[520px] w-auto xl:h-[620px]"
      />
    </div>
  </div>
</section>
