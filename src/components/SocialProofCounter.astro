---
import CounterUp from "../islands/ScrollFx/CounterUp";

interface Props {
  count: number;
  regionName: string;
  startingPriceValue: string;
  supportHoursValue: string;
}

const { count, regionName, startingPriceValue, supportHoursValue } = Astro.props;
---

<section class="bg-brand-blue/5 py-14 sm:py-16">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-4 text-center sm:grid-cols-3 sm:px-6">
    <div>
      <p class="text-4xl font-extrabold text-brand-navy sm:text-5xl">
        <CounterUp client:visible target={count} />
      </p>
      <p class="mt-2 text-slate-600">moradores de {regionName} já protegidos</p>
    </div>
    <div class="border-slate-200 sm:border-x sm:px-6">
      <p class="text-4xl font-extrabold text-brand-navy sm:text-5xl">{startingPriceValue}</p>
      <p class="mt-2 text-slate-600">a partir de, por mês</p>
    </div>
    <div>
      <p class="text-4xl font-extrabold text-brand-navy sm:text-5xl">{supportHoursValue}</p>
      <p class="mt-2 text-slate-600">de assistência, todos os dias</p>
    </div>
  </div>
</section>
