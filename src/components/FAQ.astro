---
import { getCollection } from "astro:content";
import ArrowButton from "./ArrowButton.astro";

const entries = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
---

<section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
  <h2 class="section-title reveal-up text-center">Perguntas frequentes</h2>
  <div class="mt-10 divide-y divide-slate-200">
    {
      entries.map((entry) => (
        <details class="group py-4 transition hover:bg-slate-50">
          <summary class="flex cursor-pointer list-none items-center justify-between text-left font-semibold text-brand-navy">
            {entry.data.question}
            <span class="ml-4 shrink-0 text-brand-blue transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-slate-600">{entry.data.answer}</p>
        </details>
      ))
    }
  </div>
  <div class="mt-8 flex justify-center">
    <ArrowButton href="#quero-proteger" label="Cotar agora" />
  </div>
</section>
