---
import { Image } from "astro:assets";
import icon from "../assets/brand/logo.png";

interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-2 ${className}`}>
  <Image src={icon} alt="" width={size} height={size} style={{ width: `${size}px`, height: `${size}px` }} />
  <span class="font-extrabold leading-none tracking-tight text-brand-navy">
    PROTEGE<span class="font-semibold">CLUB</span>
  </span>
</span>
