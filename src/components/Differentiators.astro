---
import ArrowButton from "./ArrowButton.astro";

const items = [
  "Mensalidade menor que o seguro tradicional",
  "Primeira mensalidade só depois de 40 dias",
  "Assistência 24h, todos os dias do ano",
  "Cobertura em todo o território nacional",
  "Atendimento direto com um consultor, sem burocracia",
];
---

<section class="px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-2xl">
    <h2 class="reveal-up text-center text-3xl font-bold text-brand-navy sm:text-4xl">
      Por que Rio Verde está escolhendo a Protege Club
    </h2>
    <div class="mt-10 space-y-3">
      {
        items.map((text) => (
          <div class="reveal-up flex items-center gap-4 rounded-2xl bg-slate-50 p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-blue/10 text-brand-blue">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path
                  fill-rule="evenodd"
                  d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
            <p class="font-medium text-brand-navy">{text}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-8 flex justify-center">
      <ArrowButton href="#quero-proteger" label="Cotar agora" />
    </div>
  </div>
</section>
