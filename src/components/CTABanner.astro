---
import ArrowButton from "./ArrowButton.astro";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<section class="bg-brand-orange">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 text-center sm:flex-row sm:px-6 sm:text-left">
    <p class="text-lg font-bold text-white">{text}</p>
    <ArrowButton href="#quero-proteger" label="Cotar agora" variant="white" class="sm:w-auto" />
  </div>
</section>
