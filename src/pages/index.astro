---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SocialProofCounter from "../components/SocialProofCounter.astro";
import HowItWorks from "../components/HowItWorks.astro";
import SavingsCalculatorSection from "../components/SavingsCalculatorSection.astro";
import Testimonials from "../components/Testimonials.astro";
import LeadFormSection from "../components/LeadFormSection.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";

const region = await getEntry("regions", "rio-verde-go");
if (!region) throw new Error("Região 'rio-verde-go' não encontrada em src/content/regions");
const {
  heroHeadline,
  heroSubheadline,
  whatsappNumber,
  protectedResidentsCount,
  displayName,
  testimonialsRef,
  startingPriceLabel,
  supportHoursLabel,
  gracePeriodDays,
} = region.data;
---

<BaseLayout
  title="Protege Club | Proteção Veicular em Rio Verde, GO a partir de R$69,90/mês"
  description="Você conquista o seu veículo, a Protege Club protege. Proteção veicular em Rio Verde, GO a partir de R$69,90/mês, com assistência 24h. Fale agora com um consultor."
>
  <Header whatsappNumber={whatsappNumber} />
  <main>
    <Hero
      regionDisplayName={displayName}
      headline={heroHeadline}
      subheadline={heroSubheadline}
      startingPriceLabel={startingPriceLabel}
      supportHoursLabel={supportHoursLabel}
      gracePeriodDays={gracePeriodDays}
    />
    <SocialProofCounter count={protectedResidentsCount} regionName={displayName} />
    <HowItWorks />
    <SavingsCalculatorSection regionSlug={region.data.slug} />
    <Testimonials testimonialIds={testimonialsRef} />
    <LeadFormSection
      regionSlug={region.data.slug}
      regionDisplayName={displayName}
      whatsappNumber={whatsappNumber}
    />
    <FAQ />
  </main>
  <Footer whatsappNumber={whatsappNumber} />
</BaseLayout>
